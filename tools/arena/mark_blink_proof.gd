extends SceneTree
## Ticks Blink Proof (MapBlock.blink_proof) on a map's outside walls, so nobody blinks
## out of the map, and clears it on every other block.
##
## A wall is an outside wall when it stands between the part of the map players get
## around in and ground they never reach. To find that part, it lays a 1 m grid over
## the map, finds each floor in every square (a face turned up with room to stand
## over it), and spreads out from the spawns, the weapon and item spots and the bots'
## jump links: from a floor to the next square's floors that are at most a step-and-a-
## jump higher (STEP), or any way lower, unless a wall stands in the way at chest height.
## Every square it reaches, at any height, is the map's own ground plan. Then each wall
## (a solid block with an upright side at least WALL_HIGH tall and WALL_WIDE wide) is
## looked at from each upright side, a step off it, straight past it (not past another
## wall behind it): if one side is the map's ground plan and another is past the map's
## fence, or off the plan where that runs to the edge of the map (ground round the map, or
## open sky) or holds BIG_OUTSIDE squares of ground or more, with nothing standing in the
## way for OPEN_PAST metres on, it is an outside wall. A gap behind a cupboard, a lift
## shaft, or a yard between two wings is not outside.
##
## It edits the scene file as text, one line per block, and leaves everything else as
## it was. Run it again after a map is changed (or regenerated by its tools/arena script):
##   godot --headless --path . --script tools/arena/mark_blink_proof.gd -- [res://game/maps/my_map.tscn ...]
## With no map named it does every arena map in Maps.LIST (races always use the grapple).
## --plans=DIR also saves a plan of each map there: the ground plan green, ground
## outside it grey, outside walls red, other walls white.
## --dry-run looks and reports, and changes no file.

const CELL := 1.0       ## grid squares, metres
const STEP := 1.3       ## the highest step up from one square to the next (a jump clears 1.18 m)
const HEAD := 1.75      ## room a floor needs over it to stand on
const CHEST := 1.0      ## the height a wall must reach to stop someone getting by (above the higher floor)
const WALL_HIGH := 0.5  ## an upright side lower than this is not a wall (a kerb)
const WALL_WIDE := 0.8
const LOOK := 1.2       ## how far off a side it looks for the floor there
const OPEN_PAST := 25.0 ## off the plan past a wall only counts if nothing stands this far on past it
const BIG_OUTSIDE := 40 ## squares of ground off the plan that make an outside (when it does not run to the map's edge)
const KEY := "blink_proof"

var _dry := false
var _plans := ""


func _initialize() -> void:
	_run.call_deferred()


func _run() -> void:
	var files: Array = []
	for arg in OS.get_cmdline_user_args():
		if arg == "--dry-run":
			_dry = true
		elif arg.begins_with("--plans="):
			_plans = arg.trim_prefix("--plans=")
			DirAccess.make_dir_recursive_absolute(_plans)
		else:
			files.append(arg)
	if files.is_empty():
		for m in Maps.LIST:
			if m.game == "ffa":
				files.append(m.scene)
	for f in files:
		await _mark(f)
	quit()


func _mark(path: String) -> void:
	var scene := load(path) as PackedScene
	var map := scene.instantiate() as MapRoot if scene else null
	if map == null:
		print("%s: not a map" % path)
		return
	root.add_child(map)
	map.build(false)
	for i in 3:
		await physics_frame
	var space := map.get_world_3d().direct_space_state

	# Where the map is: round its blocks (inside its fence, when it has one).
	var blocks: Array[MapBlock] = []
	_blocks_in(map, blocks, false)
	var extent := AABB()
	var any := false
	for b in blocks:
		var box := _world_box(b)
		extent = extent.merge(box) if any else box
		any = true
	if map.bounds.has_area():
		var fence := map.bounds
		var lo := Vector3(maxf(extent.position.x, fence.position.x), extent.position.y, maxf(extent.position.z, fence.position.y))
		var hi := Vector3(minf(extent.end.x, fence.end.x), extent.end.y, minf(extent.end.z, fence.end.y))
		extent = AABB(lo, hi - lo)
	extent = extent.grow(3.0)
	var top := extent.end.y + 2.0
	var bottom := maxf(extent.position.y - 2.0, map.kill_height)
	var x0 := floori(extent.position.x / CELL)
	var z0 := floori(extent.position.z / CELL)
	var nx := ceili(extent.end.x / CELL) - x0 + 1
	var nz := ceili(extent.end.z / CELL) - z0 + 1

	# Every floor of every square.
	var floors := {}   # Vector2i -> PackedFloat32Array (highest first)
	for ix in nx:
		for iz in nz:
			var c := Vector2i(x0 + ix, z0 + iz)
			var ys := _floors_at(space, _middle(c), top, bottom)
			if not ys.is_empty():
				floors[c] = ys

	# Spread out from where players are put or sent.
	var seeds: Array[Vector3] = []
	for s in map.spawns:
		seeds.append(s[0])
	for s in map.weapon_spawns:
		seeds.append(s[0])
	for s in map.item_spawns:
		seeds.append(s[0])
	for link in map.find_children("*", "MapJumpLink", true, false):
		seeds.append((link as Node3D).global_position)
		var land := (link as Node).get_node_or_null(link.get("landing")) as Node3D if link.get("landing") else null
		if land:
			seeds.append(land.global_position)
	var reached := {}   # Vector3i(x, z, floor index) -> true
	var plan := {}      # Vector2i -> true: squares reached at any height
	var todo: Array[Vector3i] = []
	for p in seeds:
		var c := Vector2i(floori(p.x / CELL), floori(p.z / CELL))
		var ys: PackedFloat32Array = floors.get(c, PackedFloat32Array())
		for k in ys.size():
			if ys[k] <= p.y + 0.6:   # the floor it stands on (the highest one under it)
				var at := Vector3i(c.x, c.y, k)
				if not reached.has(at):
					reached[at] = true
					todo.append(at)
				break
	while not todo.is_empty():
		var at: Vector3i = todo.pop_back()
		var c := Vector2i(at.x, at.y)
		plan[c] = true
		var y: float = (floors[c] as PackedFloat32Array)[at.z]
		for d in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
			var n: Vector2i = c + d
			if not floors.has(n):
				continue
			var ys: PackedFloat32Array = floors[n]
			for k in ys.size():
				var y2 := ys[k]
				if y2 > y + STEP:
					continue
				var to := Vector3i(n.x, n.y, k)
				if reached.has(to):
					continue
				var h := maxf(y, y2) + CHEST
				var ray := PhysicsRayQueryParameters3D.create(_middle(c) + Vector3(0, h, 0), _middle(n) + Vector3(0, h, 0), 1)
				if not space.intersect_ray(ray).is_empty():
					continue
				reached[to] = true
				todo.append(to)

	# Off the plan only counts as outside when it runs to the edge of the map (open sky
	# or ground round it), or has a lot of ground in it: not a gap behind a cupboard
	# nobody gets into, nor a lift shaft.
	var far := {}   # Vector2i -> true: squares off the plan that are really outside
	var seen := {}
	for ix in nx:
		for iz in nz:
			var c0 := Vector2i(x0 + ix, z0 + iz)
			if plan.has(c0) or seen.has(c0):
				continue
			var group: Array[Vector2i] = [c0]
			seen[c0] = true
			var edge := false
			var ground := 0
			var k := 0
			while k < group.size():
				var c: Vector2i = group[k]
				k += 1
				if floors.has(c):
					ground += 1
				if c.x <= x0 or c.y <= z0 or c.x >= x0 + nx - 1 or c.y >= z0 + nz - 1:
					edge = true
				for d in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
					var n: Vector2i = c + d
					if n.x < x0 or n.y < z0 or n.x >= x0 + nx or n.y >= z0 + nz:
						continue
					if not plan.has(n) and not seen.has(n):
						seen[n] = true
						group.append(n)
			if edge or ground >= BIG_OUTSIDE:
				for c in group:
					far[c] = true

	# The walls: outside ones have the ground plan on one side and ground off it on another.
	var proof := {}   # MapBlock -> true
	var walls: Array[MapBlock] = []
	for b in blocks:
		if not b.solid:
			continue
		var sides := _upright_sides(b)
		if sides.is_empty():
			continue
		walls.append(b)
		var inside := 0
		var outside := 0
		for side: Array in sides:
			var mid: Vector3 = side[0]
			var n: Vector3 = side[1]
			var along: Vector3 = side[2]
			var wide: float = side[3]
			var low: float = side[4]
			var high: float = side[5]
			var count := maxi(1, int(wide / CELL))
			for i in count:
				var p: Vector3 = mid + along * (((i + 0.5) / count - 0.5) * wide) + n * LOOK
				var c := Vector2i(floori(p.x / CELL), floori(p.z / CELL))
				var ys: PackedFloat32Array = floors.get(c, PackedFloat32Array())
				# (Outside only counts straight past this block: not past another wall behind it.)
				var look := PhysicsRayQueryParameters3D.create(p - n * (LOOK - 0.05), p, 1)
				look.hit_from_inside = true   # (a cupboard flush with an outside wall: the ray starts in that wall)
				var clear := space.intersect_ray(look).is_empty()
				if map.bounds.has_area() and not map.bounds.has_point(Vector2(p.x, p.z)):
					if clear:
						outside += 1   # past the map's fence
				elif plan.has(c):
					for y in ys:
						if y >= low - 3.0 and y <= high:   # (a band of wall up to a storey over the floor counts)
							inside += 1
							break
				elif far.has(c) and clear and _open_past(space, p, n):
					if ys.is_empty():
						outside += 1   # open sky
					for y in ys:
						if y <= high - 1.0:
							outside += 1
							break
		if inside >= 1 and outside >= 1:
			proof[b] = true
			if OS.has_environment("BLINK_PROOF_DEBUG"):
				print("  outside: %s (in %d, out %d) at %s" % [map.get_path_to(b), inside, outside, b.global_position])

	print("%s: %d squares of ground plan, %d walls, %d outside walls" % [path, plan.size(), walls.size(), proof.size()])
	if _plans != "":
		_save_plan(path, x0, z0, nx, nz, floors, plan, walls, proof)
	if not _dry:
		_write(path, map, blocks, proof)
	map.queue_free()
	await process_frame


## Nothing for OPEN_PAST metres on past `p` along `n`: not a shaft or a yard with a
## wall across it, but the outside.
func _open_past(space: PhysicsDirectSpaceState3D, p: Vector3, n: Vector3) -> bool:
	return space.intersect_ray(PhysicsRayQueryParameters3D.create(p, p + n * OPEN_PAST, 1)).is_empty()


func _middle(c: Vector2i) -> Vector3:
	return Vector3((c.x + 0.5) * CELL, 0.0, (c.y + 0.5) * CELL)


## The floors of a square, highest first: faces turned up with HEAD of room over them.
func _floors_at(space: PhysicsDirectSpaceState3D, at: Vector3, top: float, bottom: float) -> PackedFloat32Array:
	var ys := PackedFloat32Array()
	var y := top
	for guard in 40:
		var ray := PhysicsRayQueryParameters3D.create(Vector3(at.x, y, at.z), Vector3(at.x, bottom, at.z), 1)
		var hit := space.intersect_ray(ray)
		if hit.is_empty():
			break
		var hy: float = hit.position.y
		if (hit.normal as Vector3).y > 0.6:
			var up := PhysicsRayQueryParameters3D.create(Vector3(at.x, hy + 0.05, at.z), Vector3(at.x, hy + HEAD, at.z), 1)
			if space.intersect_ray(up).is_empty():
				ys.append(hy)
		y = hy - 0.05
	return ys


func _blocks_in(node: Node, out: Array[MapBlock], on_mover: bool) -> void:
	for child in node.get_children():
		if child is Node3D and not (child as Node3D).visible:
			continue
		var moving := on_mover or child is MapMover
		if child is MapBlock and not moving:
			out.append(child)
		_blocks_in(child, out, moving)


func _world_box(b: MapBlock) -> AABB:
	var piece := b.to_piece(Transform3D(b.global_basis, b.global_position))
	var local := MapRoot._piece_box(piece)
	return (piece.xf as Transform3D) * local


## A block's upright sides: [middle, outward normal, along it (flat), width, bottom, top]
## for each side of the box round it that stands upright and is big enough to be a wall.
func _upright_sides(b: MapBlock) -> Array:
	var piece := b.to_piece(Transform3D(b.global_basis, b.global_position))
	var xf: Transform3D = piece.xf
	var box := MapRoot._piece_box(piece)
	var half := box.size * 0.5
	var mid := xf * box.get_center()
	var world := xf * box
	var sides := []
	for axis in [0, 2, 1]:
		for sgn in [-1.0, 1.0]:
			var n: Vector3 = xf.basis[axis] * sgn
			if absf(n.y) > 0.3:
				continue
			n = Vector3(n.x, 0, n.z).normalized()
			# The side's width is the other flat axis of the box.
			var others := [0, 1, 2]
			others.erase(axis)
			var wide := 0.0
			var along := Vector3.ZERO
			for o in others:
				var v: Vector3 = xf.basis[o]
				if absf(v.y) < 0.7:
					wide = half[o] * 2.0
					along = Vector3(v.x, 0, v.z).normalized()
			var tall := world.size.y
			if wide < WALL_WIDE or tall < WALL_HIGH or half[axis] * 2.0 > tall:
				continue   # (too small, or a slab: thicker through than it is high)
			var at: Vector3 = mid + n * half[axis]
			sides.append([Vector3(at.x, world.position.y + tall * 0.5, at.z), n, along, wide, world.position.y, world.end.y])
	return sides


# ---------------------------------------------------------------------------
# The scene file

func _write(path: String, map: MapRoot, blocks: Array[MapBlock], proof: Dictionary) -> void:
	var want := {}   # "parent|name" -> true / false
	for b in blocks:
		var p := map.get_path_to(b)
		var parent := "." if p.get_name_count() == 1 else String(p).get_base_dir()
		want["%s|%s" % [parent, b.name]] = proof.has(b)
	var text := FileAccess.get_file_as_string(ProjectSettings.globalize_path(path))
	var newline := "\r\n" if text.contains("\r\n") else "\n"
	var lines := Array(text.split(newline))
	var header := RegEx.create_from_string("^\\[node name=\"((?:[^\"\\\\]|\\\\.)*)\"(?: type=\"[^\"]*\")? parent=\"([^\"]*)\"")
	var out := []
	var ticked := 0
	var cleared := 0
	var i := 0
	while i < lines.size():
		var line: String = lines[i]
		var m := header.search(line)
		if m == null:
			out.append(line)
			i += 1
			continue
		var key := "%s|%s" % [m.get_string(2), m.get_string(1).c_unescape()]
		var section := [line]
		i += 1
		while i < lines.size() and not (lines[i] as String).begins_with("["):
			section.append(lines[i])
			i += 1
		if want.has(key):
			var had := -1
			for k in section.size():
				if (section[k] as String).begins_with(KEY + " = "):
					had = k
			if want[key] and had < 0:
				# After the script line (the block's own settings follow it).
				var at := section.size()
				for k in section.size():
					if (section[k] as String).begins_with("script = "):
						at = k + 1
				section.insert(at, KEY + " = true")
				ticked += 1
			elif not want[key] and had >= 0:
				section.remove_at(had)
				cleared += 1
		out.append_array(section)
	if ticked == 0 and cleared == 0:
		print("  no change")
		return
	var f := FileAccess.open(ProjectSettings.globalize_path(path), FileAccess.WRITE)
	f.store_string(newline.join(out))
	f.close()
	print("  ticked %d, cleared %d" % [ticked, cleared])


# ---------------------------------------------------------------------------
# A plan to check it by

func _save_plan(path: String, x0: int, z0: int, nx: int, nz: int, floors: Dictionary, plan: Dictionary, walls: Array[MapBlock], proof: Dictionary) -> void:
	var px := 4
	var img := Image.create(nx * px, nz * px, false, Image.FORMAT_RGB8)
	img.fill(Color(0.08, 0.08, 0.1))
	for c: Vector2i in floors:
		var col := Color(0.25, 0.6, 0.3) if plan.has(c) else Color(0.4, 0.4, 0.42)
		img.fill_rect(Rect2i((c.x - x0) * px, (c.y - z0) * px, px, px), col)
	for b in walls:
		var col := Color(1, 0.15, 0.15) if proof.has(b) else Color(0.95, 0.95, 0.95)
		var box := _world_box(b)
		# Its footprint, as the corners of the box round it.
		var piece := b.to_piece(Transform3D(b.global_basis, b.global_position))
		var local := MapRoot._piece_box(piece)
		var xf: Transform3D = piece.xf
		var si := maxi(2, int(local.size.x / CELL * px))
		var sj := maxi(2, int(local.size.z / CELL * px))
		for i in si + 1:
			for j in sj + 1:
				var p := xf * (local.position + local.size * Vector3(float(i) / si, 0.5, float(j) / sj))
				var x := int((p.x / CELL - x0) * px)
				var y := int((p.z / CELL - z0) * px)
				if x >= 0 and y >= 0 and x < nx * px and y < nz * px:
					img.set_pixel(x, y, col)
		box = box   # (the box is only for the corners above)
	img.save_png(_plans.path_join(path.get_file().get_basename() + ".png"))
