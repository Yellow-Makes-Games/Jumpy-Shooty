; Engine configuration file.
; Edited by hand as well as by the Godot editor. Keep it readable.

config_version=5

[application]

config/name="Jumpy Shooty"
config/description="High-mobility multiplayer arena shooter."
run/main_scene="res://game/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://game/core/settings.gd"
DevArgs="*res://game/dev/dev_args.gd"
Net="*res://game/net/net.gd"
Game="*res://game/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
